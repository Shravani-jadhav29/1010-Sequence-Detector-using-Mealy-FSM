module Finite_state_cycle_tb;

reg clk;
reg rst;
reg in;
wire out;


Finite_state_cycle uut (
    .clk(clk),
    .rst(rst),
    .in(in),
    .out(out)
);


always #5 clk = ~clk;

initial begin
    clk = 0;
    rst = 1;
    in  = 0;

    #10 rst = 0;


    #10 in = 1;
    #10 in = 0;
    #10 in = 1;
    #10 in = 0; 
    #10 in = 1;
    #10 in = 0; 
    
    #20 $finish;
end

initial begin
    $monitor("Time=%0t | in=%b | out=%b", $time, in, out);
end

endmodule
